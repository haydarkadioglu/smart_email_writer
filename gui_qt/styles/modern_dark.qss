/* Modern Dark Theme for Smart Email Writer */

/* Main Window */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #1a1a2e, stop:1 #16213e);
    color: #eaeaea;
}

/* Tabs */
QTabWidget::pane {
    border: 2px solid #0f3460;
    border-radius: 8px;
    background: #16213e;
    padding: 5px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1a1a2e, stop:1 #16213e);
    color: #94a3b8;
    padding: 12px 24px;
    margin-right: 4px;
    border: 2px solid #0f3460;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4a5568, stop:1 #2d3748);
    color: #ffffff;
    border-color: #3b82f6;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: #2d3748;
    color: #e2e8f0;
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3b82f6, stop:1 #2563eb);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #2563eb, stop:1 #1d4ed8);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #1e40af, stop:1 #1e3a8a);
    padding-top: 12px;
}

QPushButton:disabled {
    background: #374151;
    color: #6b7280;
}

/* Primary Button */
QPushButton[primary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #10b981, stop:1 #059669);
    font-weight: bold;
    font-size: 14px;
    padding: 12px 24px;
}

QPushButton[primary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #059669, stop:1 #047857);
}

/* Danger Button */
QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #ef4444, stop:1 #dc2626);
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #dc2626, stop:1 #b91c1c);
}

/* Secondary Button */
QPushButton[secondary="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #4b5563, stop:1 #374151);
    color: #e5e7eb;
}

QPushButton[secondary="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #6b7280, stop:1 #4b5563);
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #1f2937;
    color: #f3f4f6;
    border: 2px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #3b82f6;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #3b82f6;
    background: #111827;
}

QLineEdit:disabled, QTextEdit:disabled {
    background: #111827;
    color: #6b7280;
}

/* ComboBox */
QComboBox {
    background: #1f2937;
    color: #f3f4f6;
    border: 2px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    min-height: 32px;
}

QComboBox:hover {
    border-color: #4b5563;
}

QComboBox:focus {
    border-color: #3b82f6;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #9ca3af;
    width: 0;
    height: 0;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background: #1f2937;
    color: #f3f4f6;
    border: 2px solid #3b82f6;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #3b82f6;
    selection-color: white;
}

/* Checkbox */
QCheckBox {
    color: #e5e7eb;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #374151;
    border-radius: 4px;
    background: #1f2937;
}

QCheckBox::indicator:hover {
    border-color: #3b82f6;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3b82f6, stop:1 #2563eb);
    border-color: #3b82f6;
}

/* Radio Button */
QRadioButton {
    color: #e5e7eb;
    spacing: 8px;
    font-size: 13px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #374151;
    border-radius: 10px;
    background: #1f2937;
}

QRadioButton::indicator:hover {
    border-color: #3b82f6;
}

QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #3b82f6, stop:1 #2563eb);
    border: 4px solid #1f2937;
    outline: 2px solid #3b82f6;
}

/* Labels */
QLabel {
    color: #e5e7eb;
    font-size: 13px;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #f9fafb;
    padding: 8px 0;
}

QLabel[subheading="true"] {
    font-size: 14px;
    font-weight: 600;
    color: #d1d5db;
}

/* GroupBox */
QGroupBox {
    background: rgba(31, 41, 55, 0.3);
    border: 2px solid #374151;
    border-radius: 8px;
    margin-top: 20px;
    padding: 20px 15px 15px 15px;
    font-weight: 600;
    font-size: 14px;
    color: #e5e7eb;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    top: 8px;
    padding: 4px 12px;
    background: #1f2937;
    border-radius: 4px;
    border: 1px solid #4b5563;
}

/* Progress Bar */
QProgressBar {
    border: 2px solid #374151;
    border-radius: 6px;
    background: #1f2937;
    text-align: center;
    color: white;
    font-weight: 600;
    height: 24px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #3b82f6, stop:0.5 #8b5cf6, stop:1 #ec4899);
    border-radius: 4px;
}

/* Scroll Bar */
QScrollBar:vertical {
    background: #1f2937;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #4b5563;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #6b7280;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1f2937;
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #4b5563;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #6b7280;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Table Widget */
QTableWidget {
    background: #1f2937;
    alternate-background-color: #374151;
    color: #f3f4f6;
    gridline-color: #4b5563;
    border: 2px solid #374151;
    border-radius: 6px;
    selection-background-color: #3b82f6;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:selected {
    background: #3b82f6;
    color: white;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #374151, stop:1 #1f2937);
    color: #f9fafb;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #4b5563;
    font-weight: 600;
    font-size: 13px;
}

QHeaderView::section:hover {
    background: #4b5563;
}

/* Status Bar */
QStatusBar {
    background: #1f2937;
    color: #9ca3af;
    border-top: 2px solid #374151;
}

QStatusBar::item {
    border: none;
}

/* Menu Bar */
QMenuBar {
    background: #1f2937;
    color: #e5e7eb;
    border-bottom: 2px solid #374151;
    padding: 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: #374151;
}

QMenuBar::item:pressed {
    background: #4b5563;
}

/* Menu */
QMenu {
    background: #1f2937;
    color: #e5e7eb;
    border: 2px solid #374151;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #3b82f6;
    color: white;
}

/* Tool Tip */
QToolTip {
    background: #1f2937;
    color: #f3f4f6;
    border: 2px solid #3b82f6;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    background: #1f2937;
    color: #f3f4f6;
    border: 2px solid #374151;
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3b82f6;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background: #374151;
    border-top-right-radius: 4px;
    width: 20px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: #4b5563;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: #374151;
    border-bottom-right-radius: 4px;
    width: 20px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #4b5563;
}
